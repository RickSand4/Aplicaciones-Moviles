<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@color/fondo_pantalla">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivUsuario"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/user"
        android:contentDescription="@string/foto_usuario" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre_ejemplo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />
        <TextView
            android:id="@+id/tvNoLeido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_leido"
            android:textColor="@color/verde_whatsapp"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvUltimaConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/conexion_ejemplo"
            android:textSize="12sp"
            android:textColor="@color/texto_secundario" />
        <TextView
            android:id="@+id/tvUltimoMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mensaje_ejemplo"
            android:textSize="14sp"
            android:textColor="@color/texto_secundario"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>