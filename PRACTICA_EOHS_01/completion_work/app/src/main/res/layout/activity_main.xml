<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla">
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/titulo_usuarios"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/verde_whatsapp" />
    <EditText
        android:id="@+id/etBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:minHeight="48dp"
        android:hint="@string/buscar_usuario"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:importantForAutofill="no"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">
            <Button
                android:id="@+id/btnTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/todos" />
            <Button
                android:id="@+id/btnNoLeidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_leidos" />
            <Button
                android:id="@+id/btnFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favoritos" />
            <Button
                android:id="@+id/btnGrupos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupos" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:id="@+id/tvResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/texto_secundario" />
    <TextView
        android:id="@+id/tvSinUsuarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone"
        android:text="@string/sin_usuarios"
        android:textColor="@color/texto_secundario" />
    <ListView
        android:id="@+id/lvUsuarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnChats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chats" />
        <Button
            android:id="@+id/btnLlamadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/llamadas" />
        <Button
            android:id="@+id/btnNovedades"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/novedades" />
    </LinearLayout>
</LinearLayout>